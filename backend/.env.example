# InterviewAce AI Backend Environment Configuration

# Choose your AI provider: "gemini" or "openai" (or "auto" to use whichever key is provided)
AI_PROVIDER=gemini

# Google Gemini API Configuration (Get your free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (Optional if using Gemini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Default is local SQLite)
DATABASE_URL=sqlite:///./interviewace.db

# JWT Authentication Secret
JWT_SECRET=interviewace_super_secret_jwt_key_placement_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
